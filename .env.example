# Camera Stream & Snapshot (ROS web_video_server)
# Di kiosk robot ganti ke localhost jika web_video_server jalan lokal
VITE_STREAM_URL=http://10.178.148.76:8080/stream?topic=/vision/image_display
VITE_SNAPSHOT_URL=http://10.178.148.76:8080/snapshot?topic=/vision/image_display

# Custom frame overlay PNG (di public/overlay.png)
VITE_OVERLAY_URL=/overlay.png

# S3 / Cloudflare R2 Credentials (Hanya disimpan di backend)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=raisa-photobooth
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://raisa-photo.yukebrillianth.com
